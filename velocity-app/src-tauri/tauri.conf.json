{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velocity",
  "version": "0.1.0",
  "identifier": "com.velocity.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Velocity",
        "width": 1680,
        "height": 1024,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A premium AI-powered code editor.",
    "longDescription": "Velocity is a desktop AI IDE with Monaco editing, project indexing, diff-based AI editing, and a premium multi-panel workspace.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/tq1r/velocity/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxOUY2ODdFREZDMTE4OEEKUldTS0dNSGZmbWlmUWFUd1dabUJmRGw4eG9rRmplYjZqbjNFY1c1cEpIbjczeDZNWitQdFRnOTIK"
    }
  }
}
