{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capability for Velocity",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "dialog:default",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:webview:allow-create-webview",
    "core:webview:allow-close"
  ]
}
